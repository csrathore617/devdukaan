# Server-side only. Never prefix these variables with VITE_.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id

# Public frontend URL permitted to call the API in production.
ALLOWED_ORIGIN=http://localhost:5173

# Set to true only when the API host is behind a trusted reverse proxy.
TRUST_PROXY=false
